load("@rules_cc//cc:cc_library.bzl", "cc_library")

cc_library(
    name = "tracy_client",
    srcs = [
        "tracy/TracyClient.cpp",
    ],
    hdrs = glob([
        "tracy/*/*.h",
        "tracy/*/*.hpp",
    ]),
    linkstatic = True,
    local_defines = [
        "TRACY_ENABLE",
        "TRACY_ON_DEMAND",
        "TRACY_MANUAL_LIFETIME",
        "TRACY_DELAYED_INIT",
    ],
    textual_hdrs = glob([
        "tracy/*/*.cpp",
    ]),
    visibility = ["//visibility:public"],
)
