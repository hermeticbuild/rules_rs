load("//rs/experimental/miri/private:sysroot.bzl", "miri_sysroot")
load("//rs/experimental/miri/private:toolchain.bzl", "miri_sysroot_toolchain")
load(":sysroot_test.bzl", "invalid_target_triple_test", "invalid_triple_toolchain", "valid_target_triple_test")

_INPUT = "sysroot_test.bzl"

_TRIPLE = "x86_64-unknown-linux-gnu"

miri_sysroot_toolchain(
    name = "valid_triple_impl",
    exec_triple = _TRIPLE,
    miri = _INPUT,
    rustc_lib = _INPUT,
    rustc_srcs = _INPUT,
    target_triple = _TRIPLE,
)

toolchain(
    name = "valid_triple_toolchain",
    toolchain = ":valid_triple_impl",
    toolchain_type = "//rs/experimental/miri:sysroot_toolchain_type",
)

invalid_triple_toolchain(name = "invalid_triple_impl")

toolchain(
    name = "invalid_triple_toolchain",
    toolchain = ":invalid_triple_impl",
    toolchain_type = "//rs/experimental/miri:sysroot_toolchain_type",
)

miri_sysroot(
    name = "subject",
    srcs = [_INPUT],
    tags = ["manual"],
)

invalid_target_triple_test(
    name = "invalid_target_triple_test",
    target_under_test = ":subject",
)

valid_target_triple_test(
    name = "valid_target_triple_test",
    expected_triple = _TRIPLE,
    target_under_test = ":subject",
)
