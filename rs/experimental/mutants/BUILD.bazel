load("@bazel_lib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//visibility:private"])

# ponytail: a label_flag, not a toolchain — one target, no registration. Promote
# to a cargo_mutants_toolchain if per-exec-platform binaries are ever needed.
label_flag(
    name = "cargo_mutants_binary",
    build_setting_default = "//rs/experimental/mutants/private:cargo_mutants_not_configured",
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "cargo_mutants_test",
    srcs = ["cargo_mutants_test.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        "//rs/experimental/mutants/private:aspect",
        "//rs/experimental/mutants/private:providers",
        "@hermetic_launcher//launcher:lib_bzl",
    ],
)
