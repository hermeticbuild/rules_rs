"""Cargo workspace package metadata emitted by rules_rs."""

# TODO(https://github.com/bazelbuild/bazel/issues/31770): Declare these fields
# in source when Bazel supports typed dictionary keys.
type _Package = dict[{
    "aliases": dict[str, str],
    "binaries": dict[str, str],
    "build_deps": list[str],
    "build_deps_by_platform": dict[str, list[str]],
    "crate_features": list[str],
    "crate_features_by_platform": dict[str, list[str]],
    "crate_name": str,
    "deps": list[str],
    "deps_by_platform": dict[str, list[str]],
    "dev_deps": list[str],
    "dev_deps_by_platform": dict[str, list[str]],
    "edition": str,
    "lint_config": NotRequired[str],
    "shared_libraries": dict[str, str],
}]

DEP_DATA: dict[str, _Package]
