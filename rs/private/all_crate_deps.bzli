"""Dependency data consumed by generated crate repositories."""

type _DependencyData = dict[{
    "deps": NotRequired[list[str]],
    "deps_by_platform": NotRequired[dict[str, list[str]]],
    "dev_deps": NotRequired[list[str]],
    "dev_deps_by_platform": NotRequired[dict[str, list[str]]],
    "build_deps": NotRequired[list[str]],
    "build_deps_by_platform": NotRequired[dict[str, list[str]]],
}, ...]

type _DependencySpec = tuple[list[str], dict[str, list[str]]]

def _filter_by_prefix(deps: Collection[str], prefix: str) -> list[str]: ...

def _kind_dep_spec(
        dep_data: _DependencyData,
        kind: Literal["deps", "dev_deps", "build_deps"],
) -> _DependencySpec: ...

def merge_structured_dep_specs(
        specs: Collection[tuple[Collection[str], Mapping[str, Collection[str]]]],
        platforms: Collection[str],
        filter_prefix: str | None,
) -> tuple[list[str], dict[str, list[str]]]: ...

def all_crate_deps(
        dep_data: _DependencyData,
        platforms: Collection[str],
        normal: bool = ...,
        normal_dev: bool = ...,
        build: bool = ...,
        filter_prefix: str | None = ...) -> list[str] | select[list[str], Literal["list"]]: ...
