"""Cargo version parsing, comparison, and requirement matching."""

type Version = tuple[int, int, int, str]
type VersionCore = tuple[int, int, int]
type ParsedVersion = dict[{"version": Version, "specified": int, "wildcard_pos": int | None}]
type Comparator = tuple[str, Version]

def _is_numeric_identifier(s: str) -> bool: ...
def _parse_version_pattern(v: str) -> ParsedVersion | None: ...
def parse_full_version(v: str) -> Version: ...
def _parse_version(v: str) -> VersionCore: ...
def _cmp_core(a: VersionCore, b: VersionCore) -> int: ...
def _cmp(a: Version, b: Version) -> int: ...
def _core_to_version(core: VersionCore) -> Version: ...
def _cargo_default_upper_bound(parsed: ParsedVersion) -> VersionCore: ...
def _tilde_upper_bound(parsed: ParsedVersion) -> VersionCore: ...
def _next_partial_upper_bound(parsed: ParsedVersion) -> VersionCore: ...
def _wildcard_upper_bound(parsed: ParsedVersion) -> VersionCore | None: ...
def _split_req_operator(req: str) -> tuple[str, str]: ...
def _satisfies_comparator(op: str, rhs_tuple: Version, ver_tuple: Version) -> bool: ...
def _normalize_req_to_comparators(req: str) -> list[Comparator]: ...
def _parse_requirement(req: str) -> list[Comparator] | None: ...
def _prerelease_allowed(version: Version, comparators: Iterable[Comparator]) -> bool: ...
def select_matching_version(req: str, versions: Iterable[str]) -> str | None: ...
