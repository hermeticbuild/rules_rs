load("@rules_cc//cc:defs.bzl", "cc_library")
load("//rs:rules_rust_bindgen.bzl", "rust_bindgen")
load(":bindgen_action_test.bzl", "bindgen_action_tests")

cc_library(
    name = "transitive_defines",
    defines = ["TRANSITIVE=1"],
    local_defines = ["PRIVATE=1"],
)

cc_library(
    name = "header",
    hdrs = ["header.h"],
    defines = [
        "FROM_CC_INFO=1",
        "OVERRIDE=1",
        "REMOVE_ME=1",
    ],
    includes = ["public"],
    deps = ["transitive_defines"],
)

rust_bindgen(
    name = "bindings_clang_cl",
    cc_lib = "header",
    clang_flags = [
        "-x",
        "c++",
        "/std:c++20",
        "/DOVERRIDE=2",
        "/UREMOVE_ME",
    ],
    header = "header.h",
    tags = ["manual"],
)

rust_bindgen(
    name = "bindings",
    cc_lib = "header",
    clang_flags = [
        "-x",
        "c++",
        "-std=c++20",
        "-DOVERRIDE=2",
        "-UREMOVE_ME",
    ],
    header = "header.h",
    tags = ["manual"],
)

bindgen_action_tests(name = "bindgen_action_tests")
