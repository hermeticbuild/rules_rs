"""Library fields consulted when detecting procedural macro crates."""

# TODO(https://github.com/bazelbuild/bazel/issues/31770): Move CargoLibrary into
# cargo_toml_utils.bzl when source can export a typed dictionary to repository_utils. A
# comment alias is local to its file.
type CargoLibrary = dict[{
    "path": NotRequired[str],
    "name": NotRequired[str],
    "proc-macro": NotRequired[bool],
    "proc_macro": NotRequired[bool],
    "crate-type": NotRequired[list[str]],
    "crate_type": NotRequired[list[str]],
}, ...]

def cargo_toml_is_proc_macro(cargo_toml_json: dict[{"lib": NotRequired[CargoLibrary]}, ...]) -> bool: ...
