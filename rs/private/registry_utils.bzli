"""Cargo source replacement and registry download configuration."""

type _RegistryConfig = dict[{"dl": str}, ...]

@overload
def resolve_registry_source(source: None, crates_io_source: str = ...) -> None: ...
@overload
def resolve_registry_source(source: str, crates_io_source: str = ...) -> str: ...
def resolve_registry_source(source: str | None, crates_io_source: str = ...) -> str | None: ...
def _cargo_field(value: object, key: str, path: str, required: bool = ...) -> object: ...
def _cargo_string(table: object, key: str, path: str) -> str | None: ...
def resolve_crates_io_source(cargo_config: object) -> str: ...
def registry_download_template(config: object) -> str: ...
def registry_download_url_from_template(template: str, crate: str, version: str, checksum: str) -> str: ...
def registry_download_url(config: _RegistryConfig, crate: str, version: str, checksum: str) -> str: ...
def registry_config_repo_name(hub_name: str, source: str) -> str: ...
def registry_repo_name(source: str) -> str: ...
def registry_path_prefix(crate: str) -> str: ...
def sharded_path(crate: str) -> str: ...
