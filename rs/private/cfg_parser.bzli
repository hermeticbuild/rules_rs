"""Types for Cargo cfg parsing and target evaluation.

Recursive aliases and dictionary fields require this companion on supported Bazel
versions: https://github.com/bazelbuild/bazel/issues/32044 and
https://github.com/bazelbuild/bazel/issues/31770.
"""

type _Token = (
    dict[{"t": Literal["IDENT", "STRING"], "v": str}]
    | dict[{"t": Literal["LPAREN", "RPAREN", "COMMA", "EQ"]}]
)
type _Combinator = Literal["all", "any", "not"]
type _Node = (
    dict[{"kind": Literal["pred"], "name": str}]
    | dict[{"kind": Literal["eq"], "key": str, "value": str}]
    | dict[{"kind": _Combinator, "args": list[_Node]}]
)
type _Frame = dict[{"fn": str, "args": list[_Node]}]
type _Instruction = (
    dict[{"op": Literal["VISIT"], "node": _Node}]
    | dict[{"op": Literal["REDUCE"], "name": _Combinator, "n": int}]
)
type _Cfg = Mapping[str, object]
type _TripleAttrs = dict[{
    "_triple": str,
    "target_arch": str,
    "target_vendor": str,
    "target_os": str,
    "target_env": str,
    "target_family": str,
    "target_endian": str,
    "target_pointer_width": str,
    "target_abi": str,
    "true": bool,
    "false": bool,
    "unix": bool,
    "windows": bool,
    "wasm": bool,
}]

type _CfgAttrs = dict[{"_triple": ReadOnly[str]}, ...]

type _Matches = struct[{"matches": list[str], "uses_feature_cfg": bool}]

def _get[T, U](xs: Sequence[T], index: int, default: U) -> T | U: ...
def _emit_pending(frames: list[_Frame], pending_ident: str | None, pending_eq_key: str | None) -> None: ...
def _cfg_tokenize(expr: str) -> list[_Token]: ...
def cfg_parse(expr: str) -> tuple[_Node, bool]: ...
def _normalize_os(os_raw: str) -> str: ...
def _normalize_arch(arch_raw: str) -> str: ...
def _split_triple(triple: str) -> tuple[str, str, str, str, str]: ...
def _family_for_os(os_name: str) -> str: ...
def _family_for_arch_and_os(arch: str, os_name: str) -> str: ...
def _pointer_width_for_arch(arch: str) -> str: ...
def _endian_for_arch(arch: str) -> str: ...
def _abi_from_env(env: str) -> str: ...
def _target_has_feature(ctx: _Cfg, feature: str) -> bool: ...
def triple_to_cfg_attrs(triple: str) -> _TripleAttrs: ...
def _eval_eq(ctx: _Cfg, key: str, value: str, features: Collection[str]) -> bool: ...
def _eval_pred(ctx: _Cfg, name: str) -> bool: ...
def _cfg_eval(ast: _Node, ctx: _Cfg, features: Collection[str] = ...) -> bool: ...
def cfg_matches(expr: str, triple: str, features: Collection[str] = ...) -> bool: ...
def cfg_matches_expr_for_triples(expr: str, triples: Collection[str], features: Collection[str] = ...) -> _Matches: ...
def cfg_matches_expr_for_cfg_attrs(expr: str, cfg_attrs: Collection[_CfgAttrs], features: Collection[str] = ...) -> _Matches: ...
def cfg_matches_ast_for_triples(ast: _Node, cfg_attrs: Collection[_CfgAttrs], features: Collection[str] = ...) -> list[str]: ...
