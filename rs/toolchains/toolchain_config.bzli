"""Read module tags from a Bazel module or a test fixture."""

# TODO(https://github.com/bazelbuild/bazel/issues/32370): Declare these shared
# fields in source when Bazel can describe a bazel_module and a test struct.
class _ToolchainModule[Config](Protocol):
    is_root: Final[bool]
    tags: Final[struct[{"toolchain": Sequence[Config]}, ...]]
